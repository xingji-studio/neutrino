Screen {
    background: #000000;
}

#start-container {
    align: center middle;
    width: 100%;
    height: 100%;
}

.logo {
    color: #99d9ea;
    text-style: bold;
    margin-bottom: 2;
    content-align: center middle;
}

.start-input {
    width: 78;
    margin-bottom: 1;
    border: none;
    height: 3;
    padding: 1 2 0 3;
}

.start-input:focus {
    background: #28393d;
}

.tab-bar {
    grid-size-columns: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 1;
    height: 3;
    width: 78;
}

.tab-button {
    border: none;
    padding: 0;
    height: 3;
    min-width: 100%;
}

.tab-button:focus {
    background: #28393d;
    color: #99d9ea;
    text-style: bold;
}

.screen-title {
    color: #99d9ea;
    text-style: bold;
    margin-top: 2;
    margin-bottom: 1;
}

.hint {
    color: #565f89;
    margin-bottom: 2;
}

#app-header {
    height: 1;
    background: #28393d;
    color: #99d9ea;
    text-style: bold;
    content-align: center middle;
}

.model-content {
    margin-top: 2;
}

#chat-log {
    height: 1fr;
    border: none;
    padding: 0 1;
}

.msg-system {
    color: #565f89;
    margin-bottom: 1;
}

.msg-user {
    color: #a9b1d6;
    margin-bottom: 1;
    margin-top: 1;
    padding: 0 1;
    border-left: solid #99d9ea;
}

.msg-assistant {
    color: #c0caf5;
    margin-bottom: 1;
    margin-top: 1;
    padding: 0 1;
}

.msg-streaming {
    border-left: solid #e0af68;
}

#pause-container {
    height: 1;
    align: center middle;
}

.pause-indicator {
    color: #e0af68;
    text-style: bold;
}

#chat-input {
    dock: bottom;
    margin: 0 1 1 1;
}

#chat-input:disabled {
    color: #565f89;
}

#history-list {
    height: 1fr;
    margin: 0 4;
}

.session-item {
    padding: 0 1;
    margin-bottom: 0;
}

.session-item.selected {
    background: #28393d;
    color: #99d9ea;
}

.empty-msg {
    color: #565f89;
    margin-top: 2;
}

.back-button {
    width: 16;
    margin-top: 2;
}

.settings-row {
    margin: 1 4;
    height: 3;
}

.settings-row > Label {
    width: 20;
    color: #a9b1d6;
}

#settings-container {
    align: center middle;
}

#model-container {
    align: center middle;
}

#history-container {
    align: center middle;
}

#model-content {
    margin-top: 2;
    color: #c0caf5;
}

#model-content > * {
    margin-bottom: 0;
}